<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kinect_v1_perception</name>
  <version>0.1.0</version>
  <description>Perception nodes on top of the Kinect v1 driver: sound detection and direction of arrival from the 4-microphone array, shown on the LED, and sound type (YAMNet).</description>
  <maintainer email="riccardo.schiavo.1@studenti.unipd.it">Riccardo Schiavo</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>audio_common_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
