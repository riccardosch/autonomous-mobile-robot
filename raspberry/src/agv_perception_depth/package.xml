<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>agv_perception_depth</name>
  <version>0.1.0</version>
  <description>Turns the Kinect v1 depth image into small obstacle and floor point clouds for the Nav2 costmaps.</description>
  <maintainer email="riccardoschiavo003@gmail.com">riccardosch</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <exec_depend>launch_ros</exec_depend>
  <!-- kinect_v1_bringup (the driver) is built in ~/kinect, sourced as an underlay -->

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
