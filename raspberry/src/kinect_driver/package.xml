<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kinect_driver</name>
  <version>0.1.0</version>
  <description>Driver for the Kinect v1 (Xbox 360) built on libfreenect: publishes the RGB image.</description>
  <maintainer email="riccardoschiavo003@gmail.com">riccardosch</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- libfreenect is built from source and installed in /usr/local (see README),
       so it is not listed here: there is no rosdep key for that build. -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
