<?xml version="1.0"?>
<package format="3">
  <name>agv_odometry</name>
  <version>0.1.0</version>
  <description>Differential-drive wheel odometry (/odom, TF) and /cmd_vel to wheel speed targets for the AGV.</description>
  <maintainer email="riccardoschiavo003@gmail.com">riccardosch</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>agv_description</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
